# API local do LM Studio (faz ponte automática com o LM Link)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Modelos por papel (ajuste conforme os modelos baixados nos seus nós)
LM_PRIMARY_MODEL=qwen3-14b
LM_VISION_MODEL=qwen2.5-vl-7b-instruct
LM_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Conversor DWG -> DXF (ODA File Converter)
# Exemplo Windows: C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
ODA_CONVERTER_PATH=

# Blender MCP (addon rodando no Blender local)
BLENDER_MCP_HOST=localhost
BLENDER_MCP_PORT=9876

# Pasta raiz dos arquivos CAD
SAMARCO_DIR=Samarco

# Cofre Obsidian 100% local (fora do OneDrive)
OBSIDIAN_VAULT_DIR=C:\ObsidianLocal\vault_samarco
